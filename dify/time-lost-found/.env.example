# 本文件不自动加载。将实际值通过本机终端或受保护的运行配置注入。
POWERCONTEXT_URL=http://127.0.0.1:8900
POWERCONTEXT_HOME=./var/powercontext
GAME_DATA_DIR=./var/game
# 仅监听本机时可留空；Dify 跨机器访问时必须设置并在 DSL 密文环境变量里同步。
BRIDGE_TOKEN=
# 可选：以凭据的 SHA256 摘要代替服务端保存原文，不与上项同时配置。
BRIDGE_TOKEN_SHA256=
# 对外演示时关闭开发接口文档。
PUBLIC_BRIDGE=1
# 只有上游 PowerContext 已启用鉴权时才填。
POWERCONTEXT_TOKEN=
# 以下两项仅供真实 Dify API 验证脚本使用，作品服务本身不读取模型密钥。
DIFY_API_URL=https://api.dify.ai/v1
DIFY_APP_API_KEY=
